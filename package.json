{
    "name": "sc-logs",
    "version": "1.0.0",
    "description": "A lightweight, beautiful, zero-dependency console logger for Node.js and TypeScript",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "tsup --watch",
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "demo": "tsx examples/demo.ts"
    },
    "keywords": [
        "logger",
        "logging",
        "console",
        "terminal",
        "ansi",
        "color",
        "typescript",
        "zero-dependency",
        "esm",
        "cjs"
    ],
    "author": "SudhuCodes",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^22.13.5",
        "tsup": "^8.4.0",
        "tsx": "^4.19.3",
        "typescript": "^5.7.3",
        "vitest": "^3.0.7"
    }
}